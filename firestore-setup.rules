// ############################################################################
// DO NOT DEPLOY THIS FILE.
// It grants any signed-in user read/write across collections including payouts,
// admins and analytics. It exists only as a record of a one-off migration.
// The deployable ruleset is firestore-production.rules, pinned in firebase.json.
// ############################################################################
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PERMISSIVE RULES FOR INITIAL SETUP
    // TODO: Restrict these rules after setup is complete
    
    // Allow all authenticated users to read/write during setup
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
